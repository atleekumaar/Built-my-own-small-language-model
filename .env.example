# ATLEE SLM LAB 2.0 — Environment Configuration Example
# Copy to .env and configure for your local or production deployment environment.

# Keras 3 Execution Backend (Default: jax)
KERAS_BACKEND=jax

# JAX Hardware Platform (Default: cpu)
JAX_PLATFORMS=cpu

# Allowed CORS Origins (Comma-separated for production, or '*' for local development)
# Example production: https://huggingface.co,https://atleeslm-lab.hf.space
CORS_ORIGINS=*

# Host & Port Binding
HOST=0.0.0.0
PORT=8000

# Maximum Generation Length Bound
MAX_NEW_TOKENS_LIMIT=100
